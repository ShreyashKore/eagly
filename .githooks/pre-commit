#!/bin/bash
# Keeps committed Dart and Rust formatted, so `dart format` / `rustfmt` never
# show up as noise in a review diff (and so CI's format gate can't fail on
# something a commit could have fixed for you).
#
# Fully-staged files are formatted and re-staged automatically. A file that is
# only *partially* staged is reported instead of rewritten: formatting the
# working copy and re-adding it would sweep the unstaged hunks into the commit.
#
# Enabled by `scripts/setup.sh`, or by hand:
#   git config core.hooksPath .githooks
# Bypass a single commit with `git commit --no-verify`.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# Git exports GIT_DIR and GIT_INDEX_FILE to hooks (absolute paths inside a
# linked worktree). fvm and Flutter's bin/dart run git against their own cache
# and SDK repos, and with these inherited that git lands on this repo instead:
# fvm 4.1 "migrated" this repo's origin into a copy of its Flutter mirror config
# that way. The hook's own git calls keep them; dart never sees them.
NO_GIT_ENV=(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX)

# Prefer the fvm-pinned SDK so the hook wraps exactly the way CI does.
if [ -x ".fvm/flutter_sdk/bin/dart" ]; then
  DART=("${NO_GIT_ENV[@]}" ".fvm/flutter_sdk/bin/dart")
elif command -v fvm >/dev/null 2>&1; then
  DART=("${NO_GIT_ENV[@]}" fvm dart)
elif command -v dart >/dev/null 2>&1; then
  DART=("${NO_GIT_ENV[@]}" dart)
else
  echo "pre-commit: no dart on PATH and no .fvm SDK — skipping format check." >&2
  exit 0
fi

# NUL-delimited read rather than `mapfile -d`, which macOS's bash 3.2 lacks.
staged=()
while IFS= read -r -d '' file; do
  staged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.dart')
rstaged=()
while IFS= read -r -d '' file; do
  rstaged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs')
[ ${#staged[@]} -eq 0 ] && [ ${#rstaged[@]} -eq 0 ] && exit 0

whole=()
partial=()
if [ ${#staged[@]} -gt 0 ]; then
  for file in "${staged[@]}"; do
    [ -f "$file" ] || continue
    if [ -n "$(git diff --name-only -- "$file")" ]; then
      partial+=("$file")
    else
      whole+=("$file")
    fi
  done
fi

status=0

if [ ${#whole[@]} -gt 0 ]; then
  if ! output="$("${DART[@]}" format "${whole[@]}" 2>&1)"; then
    echo "pre-commit: dart format failed (syntax error?):" >&2
    echo "$output" >&2
    exit 1
  fi
  reformatted=()
  for file in "${whole[@]}"; do
    if [ -n "$(git diff --name-only -- "$file")" ]; then
      reformatted+=("$file")
    fi
  done
  if [ ${#reformatted[@]} -gt 0 ]; then
    git add -- "${reformatted[@]}"
    echo "pre-commit: formatted and re-staged ${#reformatted[@]} file(s):"
    printf '  %s\n' "${reformatted[@]}"
  fi
fi

# Partially-staged files are checked, never rewritten.
if [ ${#partial[@]} -gt 0 ]; then
  for file in "${partial[@]}"; do
    if ! "${DART[@]}" format --output=none --set-exit-if-changed "$file" \
      >/dev/null 2>&1; then
      echo "pre-commit: $file is unformatted and only partially staged." >&2
      status=1
    fi
  done
fi

# ── Rust ────────────────────────────────────────────────────────────────────
# Same contract as the Dart pass, but for the crate under rust/. Each file is
# piped through rustfmt on stdin, which formats exactly that file: `cargo fmt`
# formats the whole crate whatever paths follow `--`, and `rustfmt <path>`
# follows `mod` declarations into other files — either would rewrite unstaged
# work. rustfmt runs from the crate root so it finds any rustfmt.toml there.
# Fully-staged files are rewritten and re-staged; partially-staged ones are
# checked as *staged* (the index blob), so unstaged hunks stay put and don't
# decide the verdict.
if [ ${#rstaged[@]} -gt 0 ]; then
  if command -v rustfmt >/dev/null 2>&1; then
    RUST_EDITION="$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' rust/Cargo.toml | head -n 1)"
    RUSTFMT=(rustfmt --edition "${RUST_EDITION:-2021}")
    tmp="$(mktemp)"
      err="$(mktemp)"
    trap 'rm -f "$tmp" "$err"' EXIT
    redo=()
    for file in "${rstaged[@]}"; do
      [ -f "$file" ] || continue
      if [ -n "$(git diff --name-only -- "$file")" ]; then
        if ! git show ":$file" | (cd "$REPO_ROOT/rust" && "${RUSTFMT[@]}") \
          >"$tmp" 2>/dev/null; then
          echo "pre-commit: rustfmt failed on staged $file (syntax error?)." >&2
          status=1
        elif ! git show ":$file" | cmp -s - "$tmp"; then
          echo "pre-commit: $file is unformatted and only partially staged." >&2
          status=1
        fi
        continue
      fi
      # stderr kept apart: a warning on a successful run would otherwise land
      # in the formatted source and be staged with it.
      if ! (cd "$REPO_ROOT/rust" && "${RUSTFMT[@]}") <"$file" >"$tmp" 2>"$err"; then
        echo "pre-commit: rustfmt failed on $file:" >&2
        cat "$err" >&2
        status=1
      elif ! cmp -s "$file" "$tmp"; then
        cat "$tmp" >"$file"
        redo+=("$file")
      fi
    done
    if [ ${#redo[@]} -gt 0 ]; then
      git add -- "${redo[@]}"
      echo "pre-commit: formatted and re-staged ${#redo[@]} rust file(s):"
      printf '  %s\n' "${redo[@]}"
    fi
  else
    echo "pre-commit: no rustfmt on PATH — skipping rust format check." >&2
  fi
fi

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Format the files above ('fvm dart format <file>' for Dart," >&2
  echo "rustfmt for Rust), stage the result, or commit with --no-verify" >&2
  echo "to bypass." >&2
fi

exit "$status"
